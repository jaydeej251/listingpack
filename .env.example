# Copy to .env (gitignored) for local development.
# Pick ONE provider. Priority: OLLAMA_API_KEY > OPENROUTER_API_KEY > OPENAI_API_KEY.
# A leftover OPENROUTER_API_KEY will keep calling OpenRouter even if you pasted an Ollama key into OPENAI_API_KEY.

# --- Ollama Cloud (recommended free tier for local) ---
# OLLAMA_API_KEY=
# OPENAI_MODEL=gpt-oss:20b
# Optional explicit URL (defaults to https://ollama.com/v1/chat/completions when OLLAMA_API_KEY is set):
# OPENAI_API_URL=https://ollama.com/v1/chat/completions
# If a model rejects response_format json_object (gpt-oss often returns blank):
# AI_JSON_OBJECT=off
# Vision needs a vision-capable model; Ollama defaults vision off unless:
# AI_PHOTO_VISION=on

# --- OpenRouter ---
OPENROUTER_API_KEY=
# OPENAI_MODEL=openai/gpt-4o-mini

# --- OpenAI ---
# OPENAI_API_KEY=

# AI_PHOTO_VISION=on
# AI_MAX_OUTPUT_TOKENS=2048

# Optional local PayMongo (leave blank to use Unlock Pro stub)
# PAYMONGO_SECRET_KEY=sk_test_...

# Object storage (Cloudflare R2 or AWS S3). Same keys locally and on Hatchbox.
# Development uses R2 when these are set so uploads match production.
# ACTIVE_STORAGE_SERVICE=cloud
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=
# AWS_REGION=auto
# AWS_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# AWS_FORCE_PATH_STYLE=true

# Poster rendering (libvips — no Chromium)
# POSTER_RENDERER=vips
# POSTER_RENDER_MODE=sequential
# POSTER_NEXT_WAIT_SECONDS=3
# POSTER_PHOTO_MAX_PX=2400
# Optional dev override for format count (production: unset — plan drives formats)
# POSTER_FORMAT_SET=all

# Transactional email (Resend SMTP example)
# SMTP_ADDRESS=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_...
# MAILER_FROM=ListingPack <noreply@yourdomain.com>
# APP_HOST=localhost:3000

# Production (Hatchbox) extras — do not set SOLID_QUEUE_IN_PUMA there.
# ADDITIONAL_HOSTS=www.yourdomain.com
