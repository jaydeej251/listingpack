#!/usr/bin/env bash
set -euo pipefail

# Render start command: migrate, then run web + Solid Queue in one process.
cd /rails

echo "==> Preparing database"
if [ -z "${DATABASE_URL:-}" ]; then
  echo "DATABASE_URL is not set on this service."
  echo "On Render: Web Service → Environment → add DATABASE_URL = Internal Database URL from your Postgres."
  exit 1
fi
./bin/rails db:prepare
# One DATABASE_URL: db:prepare will not load db/queue_schema.rb (Solid Queue).
./bin/rails db:prepare_solid

if [ "${SEED_ON_BOOT:-false}" = "true" ]; then
  echo "==> Seeding database"
  ./bin/rails db:seed
fi

export SOLID_QUEUE_IN_PUMA="${SOLID_QUEUE_IN_PUMA:-true}"

echo "==> Starting Rails on port ${PORT:-3000}"
exec ./bin/rails server -b 0.0.0.0 -p "${PORT:-3000}"
