#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Prepare DB for Kamal/Thruster boots. Render uses bin/render-start (prepares itself).
if { [[ "${1}" == "./bin/thrust" || "${1}" == "bin/thrust" ]] && [[ "${2}" == "./bin/rails" || "${2}" == "bin/rails" ]]; } || \
   { [[ "${1}" == "./bin/rails" || "${1}" == "bin/rails" ]] && [[ "${2}" == "server" ]]; }; then
  ./bin/rails db:prepare
  ./bin/rails db:prepare_solid
fi

exec "${@}"
