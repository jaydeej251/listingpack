# See https://help.github.com/articles/ignoring-files for more about ignoring files.
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity
.byebug_history
/config/master.key
/config/credentials/*.key
.kamal/secrets
.env
.env*.local
/coverage
.DS_Store
