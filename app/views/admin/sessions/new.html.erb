<% content_for :title, "Operator login — ListingPack" %>

<div class="mx-auto max-w-md">
  <p class="kicker">Operator</p>
  <h1 class="mt-2 font-serif text-4xl text-navy">Admin login</h1>
  <p class="mt-3 text-sm text-navy/65">This is the support console. Agents use the studio login — operator accounts cannot post listings here.</p>

  <%= form_with url: admin_session_url, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
    </div>
    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field" %>
    </div>
    <%= form.submit "Log in", class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-sm text-navy/60">
    <%= link_to "Agent login", new_session_path, class: "underline" %>
  </p>
</div>
