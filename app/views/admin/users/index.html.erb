<% content_for :title, "Users — ListingPack" %>

<%= render "shared/page_header",
      kicker: "Admin",
      title: "Users",
      description: "Agents only. Operators log in at /admin/login and do not appear in this list.",
      actions: link_to("Failures", admin_failures_path, class: "btn btn-secondary") %>

<%= form_with url: admin_users_path, method: :get, class: "mt-8 flex flex-wrap gap-3" do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: "Search email", class: "field max-w-md", aria: { label: "Search email" } %>
  <%= form.submit "Search", class: "btn btn-primary" %>
<% end %>

<% if @users.any? %>
  <ul class="mt-6 space-y-3">
    <% @users.each do |user| %>
      <li class="card p-4 text-sm">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="font-medium text-navy"><%= user.email_address %></p>
            <p class="mt-1 text-navy/65">
              <%= plan_badge(user) %>
              · <%= admin_quota_summary(user) %>
              · joined <%= user.created_at.to_date %>
              <% if user.admin? %> · operator<% end %>
            </p>
          </div>
          <%= link_to "Open", admin_user_path(user), class: "underline text-clay" %>
        </div>
      </li>
    <% end %>
  </ul>
  <p class="mt-4 text-xs text-navy/50">Showing up to 50 most recent matches.</p>
<% else %>
  <p class="mt-6 text-sm text-navy/60">No users match that search.</p>
<% end %>
