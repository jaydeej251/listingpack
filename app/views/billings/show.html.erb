<% content_for :title, "Plan — ListingPack" %>

<%= render "shared/page_header",
      kicker: "Billing",
      title: "Plan",
      description: "You are on #{plan_badge(current_user)}. Pro adds unlimited packs, clean posters, and one-tap Facebook share from Listings." %>

<div class="mt-10 grid gap-6 lg:grid-cols-3">
  <article class="card p-6 <%= "ring-2 ring-navy" unless current_user.pro? %>">
    <p class="kicker">Starter</p>
    <h2 class="mt-2 font-serif text-2xl text-navy">Free</h2>
    <p class="mt-2 text-3xl text-navy">₱0</p>
    <ul class="mt-4 space-y-2 text-sm text-navy/70">
      <li><%= User::FREE_PACKS_PER_MONTH %> packs / month</li>
      <li>1 square poster per pack (small corner credit)</li>
      <li>Captions, seller recap, and This week</li>
      <li>No Facebook share from Listings</li>
      <li><%= current_user.pro? ? "Upgrade path if you pause Pro" : "#{current_user.remaining_packs} left this month" %></li>
    </ul>
    <% unless current_user.pro? %>
      <p class="mt-6 text-sm font-medium text-navy">Current plan</p>
    <% end %>
  </article>
  <article class="rounded-[1.25rem] bg-navy p-6 text-paper <%= "ring-2 ring-clay" if current_user.pro? %>">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay">For agents posting weekly</p>
    <h2 class="mt-2 font-serif text-2xl">Pro</h2>
    <p class="mt-2 text-3xl">₱<%= User::PRO_PRICE_PHP %><span class="text-base font-sans opacity-70">/mo</span></p>
    <ul class="mt-4 space-y-2 text-sm text-paper/75">
      <li>Unlimited packs</li>
      <li>All 6 poster formats — square, story, 16:9, banner</li>
      <li>No corner credit on posters</li>
      <li>Share to Facebook, WhatsApp, or copy the listing link</li>
      <li>Same copy and This week — without the monthly cap</li>
    </ul>
    <% if current_user.pro? %>
      <p class="mt-6 text-sm">Already Pro on this account.</p>
    <% elsif Billing::Paymongo.configured? %>
      <%= button_to "Upgrade with GCash / Maya", billing_path, method: :post, class: "btn mt-6 bg-clay text-paper hover:bg-paper hover:text-navy", data: { turbo: false } %>
      <p class="mt-3 text-xs text-paper/60">Checkout opens on PayMongo. Pro unlocks after payment is confirmed.</p>
    <% elsif Rails.env.local? %>
      <%= button_to "Unlock Pro (local stub)", billing_path, method: :patch, class: "btn mt-6 bg-clay text-paper hover:bg-paper hover:text-navy" %>
      <p class="mt-3 text-xs text-paper/60">Local demos only. Set PAYMONGO_SECRET_KEY to use real checkout.</p>
    <% else %>
      <p class="mt-6 text-sm text-paper/80">PayMongo is not configured on this server yet. Ask the operator to set PAYMONGO_SECRET_KEY.</p>
    <% end %>
  </article>
  <article class="card p-6 opacity-95">
    <p class="kicker">Coming later</p>
    <h2 class="mt-2 font-serif text-2xl text-navy">Pro Plus</h2>
    <p class="mt-2 text-3xl text-navy">₱<%= User::PRO_PLUS_INTRO_PRICE_PHP %><span class="text-base font-sans text-navy/50">/mo</span></p>
    <p class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-clay">Introductory price</p>
    <ul class="mt-4 space-y-2 text-sm text-navy/70">
      <li>Everything in Pro</li>
      <li>Optional automatic share to a connected Facebook Page</li>
      <li>Same auto-share path for other social channels later</li>
      <li>You stay in control — never posts unless you turn it on</li>
    </ul>
    <p class="mt-6 text-sm text-navy/60">Not for sale yet. One-tap Share on Pro is the first step; auto-post waits until that workflow sticks.</p>
  </article>
</div>
