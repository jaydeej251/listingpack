<% variant = local_assigns.fetch(:variant, "just_listed") %>
<% wrapper = local_assigns.fetch(:class, "w-full") %>
<% uid = SecureRandom.hex(4) %>
<% ratio = GeneratedAsset::FORMATS.key?(variant) ? GeneratedAsset.aspect_ratio_css(variant) : "1 / 1" %>

<%# Sizing comes from poster-size-* / width classes in CSS — do not rely on arbitrary Tailwind utilities. %>
<div class="lift <%= wrapper %>">
  <div class="poster-mock" style="aspect-ratio: <%= ratio %>;">
    <div class="poster-mock-fill">
      <% case variant %>
      <% when "price_card" %>
        <div class="flex h-full flex-col bg-paper">
          <div class="h-[58%] overflow-hidden">
            <%= render "pages/sample_photo", uid: uid, class: "h-full w-full object-cover" %>
          </div>
          <div class="flex flex-1 flex-col justify-between p-[6%] text-navy">
            <div>
              <p class="poster-badge font-bold uppercase text-clay">Price reduced</p>
              <p class="poster-subtitle mt-[3%] font-serif">3BR in Cebu Business Park</p>
            </div>
            <div>
              <p class="poster-meta text-navy/50 line-through">₱9,800,000</p>
              <p class="poster-price font-bold">₱8,950,000</p>
            </div>
          </div>
        </div>
      <% when "agent_card" %>
        <div class="h-full bg-navy p-[5%]">
          <div class="flex h-full flex-col overflow-hidden rounded-xl border border-paper/25">
            <div class="relative flex-1 overflow-hidden">
              <%= render "pages/sample_photo", uid: uid, class: "h-full w-full object-cover" %>
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy to-transparent p-[6%]">
                <p class="poster-badge font-bold uppercase text-clay">Your agent</p>
                <p class="poster-title mt-[2%] font-serif text-paper">Open house Sunday</p>
              </div>
            </div>
            <div class="flex items-center gap-[5%] p-[6%] text-paper">
              <div class="flex aspect-square w-[22%] items-center justify-center rounded-full bg-clay font-serif text-[7cqw]">M</div>
              <div>
                <p class="poster-meta font-semibold">Maria Santos</p>
                <p class="poster-meta text-paper/70">BGC, Taguig · DM for viewing</p>
              </div>
            </div>
          </div>
        </div>
      <% when "story" %>
        <%= render "pages/sample_photo", uid: uid, class: "absolute inset-0 h-full w-full object-cover" %>
        <div class="absolute inset-0 bg-gradient-to-b from-navy/10 via-navy/25 to-navy/95"></div>
        <div class="absolute left-[8%] top-[6%] rounded-sm bg-clay px-[4%] py-[1.4%] text-paper">
          <span class="poster-badge font-bold uppercase">Just listed</span>
        </div>
        <div class="absolute inset-x-[8%] bottom-[8%] text-paper">
          <p class="poster-eyebrow uppercase text-paper/70">BGC, Taguig</p>
          <p class="poster-title mt-[3%] font-serif">2BR at The Fort</p>
          <p class="poster-price mt-[4%] font-bold">₱12,500,000</p>
          <p class="poster-meta mt-[3%] text-paper/80">Story · 9:16</p>
        </div>
      <% when "landscape" %>
        <%= render "pages/sample_photo", uid: uid, class: "absolute inset-0 h-full w-full object-cover" %>
        <div class="absolute inset-0 bg-gradient-to-r from-navy/90 via-navy/50 to-navy/15"></div>
        <div class="absolute left-[5%] top-[10%] rounded-sm bg-clay px-[3%] py-[1.2%] text-paper">
          <span class="poster-badge font-bold uppercase">Just listed</span>
        </div>
        <div class="absolute bottom-[10%] left-[5%] right-[40%] text-paper">
          <p class="poster-eyebrow uppercase text-paper/70">BGC, Taguig</p>
          <p class="poster-title mt-[2%] font-serif">2BR at The Fort Residences</p>
          <p class="poster-price mt-[3%] font-bold">₱12,500,000</p>
        </div>
      <% when "fb_banner" %>
        <%= render "pages/sample_photo", uid: uid, class: "absolute inset-0 h-full w-full object-cover" %>
        <div class="absolute inset-0 bg-gradient-to-r from-navy/90 via-navy/55 to-transparent"></div>
        <div class="absolute inset-y-0 left-[4%] flex w-[70%] flex-col justify-center text-paper">
          <p class="poster-badge font-bold uppercase text-clay">Facebook banner</p>
          <p class="poster-subtitle mt-[2%] font-serif">2BR at The Fort Residences</p>
          <p class="poster-price mt-[2%] font-bold">₱12,500,000</p>
        </div>
      <% else %>
        <%= render "pages/sample_photo", uid: uid, class: "absolute inset-0 h-full w-full object-cover" %>
        <div class="absolute inset-0 bg-gradient-to-b from-navy/5 via-navy/35 to-navy/95"></div>
        <div class="absolute left-[6%] top-[6%] rounded-full bg-clay px-[3.5%] py-[1.6%] text-paper">
          <span class="poster-badge font-bold uppercase">Just listed</span>
        </div>
        <div class="absolute inset-x-[6%] bottom-[6%] text-paper">
          <p class="poster-eyebrow uppercase text-paper/70">BGC, Taguig</p>
          <p class="poster-title mt-[2%] font-serif">2BR at The Fort Residences</p>
          <p class="poster-price mt-[3%] font-bold">₱12,500,000</p>
          <p class="poster-meta mt-[2%] text-paper/85">2BR · 2BA · 58 sqm · parking included</p>
          <p class="poster-meta mt-[4%] text-paper/70">Maria Santos · 0917 000 0000</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
