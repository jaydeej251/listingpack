<% content_for :title, "Listing graphics for PH agents — ListingPack" %>
<% content_for :full_bleed, true %>

<%
  week_posts = [
    [ "Mon", "Market pulse", "BGC buyers this week are asking two things: parking at saan malapit sa bus stop. If your budget is ₱12M and below, message me — may tatlo akong units na pasok." ],
    [ "Tue", "Buyer tip", nil ],
    [ "Wed", "Neighborhood spotlight", nil ],
    [ "Thu", "Myth vs fact", nil ],
    [ "Fri", "Open house invite", nil ]
  ]

  caption_tabs = [
    [ "facebook", "Facebook", "Facebook profile · 6:00 PM",
      "Just listed sa BGC — 2BR, 58 sqm, may parking na. Seller needs a 60-day close kaya may room pa for serious buyers. Pag-IBIG and bank financing both okay. DM lang po for viewing." ],
    [ "marketplace", "Marketplace", "Marketplace listing · blurb",
      "2BR condo for sale in BGC, Taguig. 58 sqm, 2 bathrooms, 1 parking slot, ₱8,500/mo association dues. Walking distance to BGC Bus. Pag-IBIG, bank, and cash accepted. Price: ₱12,500,000. Message for the full spec sheet and viewing schedule." ],
    [ "instagram", "Instagram", "Instagram caption · carousel",
      "Golden hour sa The Fort Residences. 2BR, 58 sqm, parking included — and the unit faces away from the highway kaya tahimik talaga. Swipe for the floor plan. Link in bio to book a viewing." ],
    [ "messenger", "Messenger", "Follow-up DM · day 2",
      "Hi po! Kayo yung nag-inquire sa 2BR sa BGC. Still available po siya. Free ba kayo this Saturday, 10AM or 2PM? Dala ko na rin yung computation for Pag-IBIG para makita niyo agad yung monthly." ]
  ]

  comparison = [
    [ "Facebook and Instagram captions", true ],
    [ "Branded 1080×1080 poster, no Canva", false ],
    [ "Seller recap you can send the owner", false ],
    [ "Five posts for a week with no listing", false ],
    [ "Marketplace blurb and Messenger follow-up", false ],
    [ "Click-to-enlarge posters you can download", false ]
  ]

  faqs = [
    [ "Kailangan ko pa ba ng Canva?", "No. The poster comes out as a 1080×1080 PNG with your logo, colors, and photo already stamped on it. Download and post." ],
    [ "Will it sound like a bot?", "Paste three of your real Facebook posts in the brand kit. Captions copy your rhythm, your Taglish, and your call to action instead of a generic FOMO template." ],
    [ "Anong wika ang lalabas?", "Taglish, English, or Filipino — you pick per listing." ],
    [ "Paano ang bayad?", "Free is three packs a month with a watermark. Pro is ₱499/mo for unlimited packs and clean posters — pay with GCash, Maya, or card via PayMongo when you upgrade on Plan. Facebook auto-post is still later." ]
  ]
%>

<section class="hero-plane grain relative">
  <div class="relative z-10 mx-auto grid min-h-[min(68vh,560px)] max-w-6xl items-end gap-10 px-5 pb-14 pt-16 lg:grid-cols-12 lg:items-center lg:pb-20 lg:pt-20">
    <div class="lg:col-span-7">
      <p class="rise hero-brand">ListingPack</p>
      <h1 class="rise rise-1 mt-6 max-w-xl font-serif text-3xl leading-tight text-white sm:text-4xl">
        Upload a listing.<br>
        Get posts you can actually publish.
      </h1>
      <p class="rise rise-2 mt-5 max-w-md text-base leading-relaxed text-white/75 sm:text-lg">
        Graphics, captions, and a seller recap — ready to post when captions-only tools leave you in Canva.
      </p>
      <div class="rise rise-3 mt-8 flex flex-wrap gap-3">
        <%= link_to "Start free — 3 packs/month", new_registration_path, class: "btn bg-clay px-6 py-3 text-paper hover:bg-paper hover:text-navy" %>
        <%= link_to "See a real pack", "#how", class: "btn border border-white/30 bg-transparent px-6 py-3 text-paper hover:bg-white/10" %>
      </div>
    </div>

    <div class="rise rise-2 lg:col-span-5" aria-hidden="true">
      <div class="hero-poster-reveal mx-auto w-fit lg:ml-auto lg:mr-0">
        <%= render "pages/sample_poster", variant: "just_listed", class: "poster-size-hero" %>
      </div>
    </div>
  </div>
</section>

<div class="mx-auto max-w-6xl px-5 py-10">
  <p class="text-center text-sm text-navy/55">
    Facebook · Marketplace · Instagram · Messenger · Seller report — one pack covers the channels you already use.
  </p>

  <section id="how" class="mt-16">
    <div class="max-w-2xl">
      <p class="kicker">What lands in your studio</p>
      <h2 class="mt-3 font-serif text-4xl text-navy">Three things captions-only tools don’t give you</h2>
      <p class="mt-3 text-navy/70">Not mockups — this is what a pack actually looks like.</p>
    </div>

    <div class="mt-12 space-y-20">
      <article class="grid items-start gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4 lg:pt-2">
          <p class="kicker">01 · The graphic</p>
          <h2 class="mt-2 font-serif text-3xl text-navy">Branded 1080×1080, no Canva</h2>
          <p class="mt-3 text-navy/70">Your logo, your colors, your photo. Every pack ships three templates for the stage you’re in.</p>
        </div>
        <div class="flex flex-col items-stretch lg:col-span-8 lg:items-end">
          <div class="poster-pack mx-auto w-full lg:mx-0">
            <%= render "pages/sample_poster", variant: "just_listed", class: "poster-size-equal" %>
            <%= render "pages/sample_poster", variant: "price_card", class: "poster-size-equal" %>
            <%= render "pages/sample_poster", variant: "agent_card", class: "poster-size-equal" %>
          </div>
          <p class="mt-3 text-center text-xs text-navy/50 lg:text-right">Just listed · price card · agent card</p>
        </div>
      </article>

      <article class="grid items-center gap-10 lg:grid-cols-12">
        <div class="order-2 lg:order-1 lg:col-span-7">
          <div class="rounded-sm bg-surface p-6 ring-1 ring-navy/10 sm:p-8">
            <div class="flex items-center justify-between border-b border-navy/10 pb-3">
              <p class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-clay">Weekly seller update</p>
              <span class="text-xs font-medium text-navy/50">Week 2</span>
            </div>
            <p class="mt-3 font-serif text-xl text-navy">2BR at The Fort Residences</p>
            <p class="mt-2 text-sm leading-relaxed text-navy/75">Hi Mr. Cruz — mabilis na recap ng week 2.</p>
            <dl class="mt-4 grid grid-cols-3 gap-2 text-center">
              <% [ [ "Reach", "4,180" ], [ "Saves", "41" ], [ "Viewings", "2" ] ].each do |label, value| %>
                <div class="rounded-lg bg-sand py-2">
                  <dt class="text-[0.6rem] uppercase tracking-[0.12em] text-navy/55"><%= label %></dt>
                  <dd class="font-semibold text-navy"><%= value %></dd>
                </div>
              <% end %>
            </dl>
            <p class="mt-4 text-sm leading-relaxed text-navy/75">
              Buyers keep asking about parking and Pag-IBIG. Two viewings booked for Saturday.
              My recommendation: hold the price one more week, then reduce to ₱12.2M if walk-ins stay flat.
            </p>
          </div>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-5">
          <p class="kicker">02 · The seller recap</p>
          <h2 class="mt-2 font-serif text-3xl text-navy">The update the owner keeps asking for</h2>
          <p class="mt-3 text-navy/70">Already written. Copy it into Messenger or print it for Friday.</p>
        </div>
      </article>

      <article class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker">03 · The empty week</p>
          <h2 class="mt-2 font-serif text-3xl text-navy">Five posts when you have no listing</h2>
          <p class="mt-3 text-navy/70">Mon–Fri so a slow month doesn’t make you disappear.</p>
        </div>
        <div class="lg:col-span-7">
          <ol class="space-y-2 rounded-sm bg-surface p-4 ring-1 ring-navy/10 sm:p-5">
            <% week_posts.each do |day, title, body| %>
              <li class="rounded-lg border px-3 py-2.5 <%= body ? "border-clay/35 bg-clay/5" : "border-navy/10" %>">
                <div class="flex items-center gap-3">
                  <span class="w-9 shrink-0 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-clay"><%= day %></span>
                  <span class="text-sm font-medium text-navy"><%= title %></span>
                </div>
                <% if body %>
                  <p class="mt-2 text-sm leading-relaxed text-navy/75"><%= body %></p>
                <% end %>
              </li>
            <% end %>
          </ol>
        </div>
      </article>
    </div>
  </section>

  <section class="mt-20" data-controller="tabs" data-tabs-active-value="facebook">
    <div class="max-w-2xl">
      <p class="kicker">In your voice</p>
      <h2 class="mt-3 font-serif text-4xl text-navy">The same listing, written per channel</h2>
      <p class="mt-3 text-navy/70">One pack fills every box you normally rewrite by hand.</p>
    </div>

    <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Channel captions">
      <% caption_tabs.each do |id, label, _meta, _body| %>
        <button
          type="button"
          class="btn btn-secondary"
          role="tab"
          id="home-tab-<%= id %>"
          aria-controls="home-panel-<%= id %>"
          aria-selected="<%= id == "facebook" %>"
          tabindex="<%= id == "facebook" ? "0" : "-1" %>"
          data-tabs-target="tab"
          data-tabs-id-param="<%= id %>"
          data-action="tabs#select keydown->tabs#keydown"
        ><%= label %></button>
      <% end %>
    </div>

    <% caption_tabs.each do |id, _label, meta, body| %>
      <div
        class="mt-5 max-w-2xl rounded-sm bg-surface p-6 ring-1 ring-navy/10 <%= "hidden" unless id == "facebook" %>"
        data-tabs-target="panel"
        data-tab="<%= id %>"
        role="tabpanel"
        id="home-panel-<%= id %>"
        aria-labelledby="home-tab-<%= id %>"
        <%= "hidden" unless id == "facebook" %>
      >
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-navy/55"><%= meta %></p>
        <p class="mt-4 leading-relaxed text-navy/85"><%= body %></p>
      </div>
    <% end %>
  </section>

  <section class="mt-20 grid gap-6 lg:grid-cols-2 lg:items-stretch">
    <div class="rounded-sm bg-surface p-7 ring-1 ring-navy/10">
      <p class="kicker">Captions-only tools</p>
      <h2 class="mt-2 font-serif text-3xl text-navy">You still open Canva</h2>
      <ul class="mt-6 space-y-3">
        <% comparison.each do |label, included| %>
          <li class="flex items-start gap-3 text-sm <%= included ? "text-navy/80" : "text-navy/40" %>">
            <span class="mt-0.5 w-4 shrink-0 text-center font-bold"><%= included ? "✓" : "—" %></span>
            <span><%= label %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="surface-navy grain p-7">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay">ListingPack</p>
      <h2 class="mt-2 font-serif text-3xl">You post straight from the pack</h2>
      <ul class="mt-6 space-y-3">
        <% comparison.each do |label, _included| %>
          <li class="flex items-start gap-3 text-sm text-paper/85">
            <span class="mt-0.5 w-4 shrink-0 text-center font-bold text-clay">✓</span>
            <span><%= label %></span>
          </li>
        <% end %>
      </ul>
      <%= link_to "Start free", new_registration_path, class: "btn mt-7 bg-clay text-paper hover:bg-paper hover:text-navy" %>
    </div>
  </section>

  <section class="mt-20">
    <div class="max-w-2xl">
      <p class="kicker">Pricing</p>
      <h2 class="mt-3 font-serif text-4xl text-navy">Try it on your next listing</h2>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <article class="rounded-sm bg-surface p-6 ring-1 ring-navy/10">
        <h3 class="font-serif text-2xl text-navy">Free</h3>
        <p class="mt-2 text-3xl text-navy">₱0</p>
        <ul class="mt-4 space-y-2 text-sm text-navy/70">
          <li><%= User::FREE_PACKS_PER_MONTH %> packs per month</li>
          <li>All three poster templates</li>
          <li>Watermark on posters</li>
          <li>No card required</li>
        </ul>
        <%= link_to "Create account", new_registration_path, class: "btn btn-secondary mt-6" %>
      </article>

      <article class="surface-navy grain p-6">
        <div class="flex items-center justify-between">
          <h3 class="font-serif text-2xl">Pro</h3>
          <span class="chip chip-dark">Most agents</span>
        </div>
        <p class="mt-2 text-3xl">₱499<span class="font-sans text-base opacity-70">/mo</span></p>
        <ul class="mt-4 space-y-2 text-sm text-paper/80">
          <li>Unlimited packs</li>
          <li>No watermark on posters</li>
          <li>Weekly calendars for every slow week</li>
          <li>Pay with GCash / Maya / card (PayMongo)</li>
          <li>Facebook auto-post — coming later</li>
        </ul>
        <%= link_to "Start free, upgrade later", new_registration_path, class: "btn mt-6 bg-clay text-paper hover:bg-paper hover:text-navy" %>
      </article>
    </div>
  </section>

  <section class="mt-20 grid gap-8 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="kicker">Questions</p>
      <h2 class="mt-3 font-serif text-4xl text-navy">Before you sign up</h2>
      <p class="mt-4 text-sm text-navy/55">
        Hosted demos on free tiers can take about a minute to wake after idle — refresh once if the first load is slow.
      </p>
    </div>
    <div class="space-y-3 lg:col-span-8">
      <% faqs.each do |question, answer| %>
        <details class="rounded-sm bg-surface p-5 ring-1 ring-navy/10">
          <summary class="cursor-pointer font-medium text-navy"><%= question %></summary>
          <p class="mt-3 text-sm leading-relaxed text-navy/70"><%= answer %></p>
        </details>
      <% end %>
    </div>
  </section>

  <section class="surface-navy grain mt-20 px-6 py-14 text-center sm:px-12">
    <h2 class="mx-auto max-w-2xl font-serif text-4xl leading-tight sm:text-5xl">Your next listing can be posted before lunch.</h2>
    <p class="mx-auto mt-4 max-w-xl text-paper/75">Photos in, pack out. Three free packs a month, no card.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <%= link_to "Start free", new_registration_path, class: "btn bg-clay px-6 py-3 text-paper hover:bg-paper hover:text-navy" %>
      <%= link_to "Log in", new_session_path, class: "btn chip-dark px-6 py-3" %>
    </div>
  </section>
</div>
