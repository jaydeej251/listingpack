<%# locals: listing:, pack:, asset:, key: %>
<% attached = asset&.image&.attached? %>
<% status = if attached || asset&.status == "ready"
      "ready"
    elsif asset&.failed?
      "failed"
    elsif asset&.rendering?
      "generating"
    elsif asset&.pending?
      "waiting"
    else
      "waiting"
    end %>
<% image_url = attached ? url_for(asset.image) : nil %>
<% download_url = attached ? rails_blob_path(asset.image, disposition: "attachment") : nil %>
<% ratio = GeneratedAsset.aspect_ratio_css(key) %>
<% label = GeneratedAsset.format_for(key).fetch(:label) %>

<figure class="card p-3" data-controller="poster" data-poster-key="<%= key %>" data-poster-image-url-value="<%= image_url %>" data-poster-status="<%= status %>">
  <% if status == "ready" && attached %>
    <button type="button" class="poster-hit" data-action="poster#open" aria-haspopup="dialog" aria-controls="poster-dialog-<%= asset.id %>">
      <%= image_tag asset.image,
            class: "w-full rounded-xl object-cover",
            style: "aspect-ratio: #{ratio};",
            alt: "#{label} — click to enlarge" %>
    </button>
    <dialog
      class="poster-dialog"
      id="poster-dialog-<%= asset.id %>"
      data-poster-target="dialog"
      data-action="click->poster#backdrop"
      aria-labelledby="poster-dialog-title-<%= asset.id %>"
    >
      <div class="poster-dialog-body">
        <h2 id="poster-dialog-title-<%= asset.id %>" class="sr-only"><%= label %></h2>
        <%= image_tag asset.image, alt: label %>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
          <%= link_to "Download PNG", download_url, class: "btn btn-primary py-2 text-sm", data: { turbo: false } %>
          <button type="button" class="btn btn-secondary py-2 text-sm" data-poster-target="copyButton" data-action="poster#copyImage">Copy image</button>
          <button type="button" class="btn btn-ghost py-2 text-sm" data-poster-target="closeButton" data-action="poster#close">Close</button>
        </div>
      </div>
    </dialog>
  <% elsif status == "generating" %>
    <div class="flex flex-col items-center justify-center gap-2 rounded-xl bg-sand p-4 text-center" style="aspect-ratio: <%= ratio %>;" aria-busy="true">
      <span class="inline-block h-5 w-5 animate-spin rounded-full border-2 border-navy/20 border-t-clay" aria-hidden="true"></span>
      <p class="text-sm font-medium text-navy">Generating…</p>
      <p class="text-xs text-navy/55">Rendering this format</p>
    </div>
  <% elsif status == "failed" %>
    <div class="flex flex-col items-center justify-center gap-2 rounded-xl bg-sand p-4 text-center" style="aspect-ratio: <%= ratio %>;">
      <p class="text-sm font-medium text-navy">Couldn’t render</p>
      <p class="text-xs text-navy/60"><%= asset.error_message.presence || "Tap Redraw to try again." %></p>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center gap-2 rounded-xl bg-sand/80 p-4 text-center" style="aspect-ratio: <%= ratio %>;">
      <p class="text-sm font-medium text-navy/70">Waiting…</p>
      <p class="text-xs text-navy/50">Queued</p>
    </div>
  <% end %>
  <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm">
    <span class="font-medium text-navy">
      <%= label %>
      <% if status == "generating" %>
        <span class="ml-1 text-clay">· Generating</span>
      <% elsif status == "waiting" %>
        <span class="ml-1 text-navy/45">· Waiting</span>
      <% end %>
    </span>
    <span class="flex flex-wrap items-center gap-2">
      <% if attached %>
        <button type="button" class="text-navy underline" data-action="poster#open">View</button>
        <%= link_to "Download PNG", download_url, class: "btn btn-primary py-1 text-sm", data: { turbo: false } %>
      <% end %>
      <% if asset&.persisted? && status != "generating" && listing_owner?(listing) %>
        <%= button_to "Redraw", regenerate_listing_content_pack_generated_asset_path(listing, pack, asset), method: :post, class: "text-clay" %>
      <% end %>
    </span>
  </figcaption>
</figure>
