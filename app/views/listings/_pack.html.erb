<% if listing.generating? %>
  <div class="card mt-10 p-8" aria-busy="true" aria-live="polite">
    <p class="kicker">Working</p>
    <h2 class="mt-2 font-serif text-3xl text-navy">Building this pack</h2>
    <ol class="mt-6 space-y-3 text-navy/80">
      <li class="flex gap-3"><span class="text-clay">1</span> Reading listing photos</li>
      <li class="flex gap-3"><span class="text-clay">2</span> Writing captions, Messenger follow-up, and seller recap</li>
      <li class="flex gap-3"><span class="text-clay">3</span> Stamping branded posters</li>
    </ol>
    <p class="mt-4 text-sm text-navy/60">Usually 10–30 seconds. This page refreshes on its own.</p>
  </div>
<% elsif listing.failed? %>
  <div class="card mt-10 border-clay/30 p-8">
    <h2 class="font-serif text-3xl text-navy">Generation failed</h2>
    <p class="mt-3 text-navy/70"><%= pack&.error_message || "The worker hit an error." %></p>
    <%= button_to "Retry (does not use a free pack)", retry_listing_content_packs_path(listing), method: :post, class: "btn btn-primary mt-6" %>
  </div>
<% elsif pack&.ready? %>
  <% unless listing.price_confirmed? %>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-clay/40 bg-clay/10 px-5 py-4">
      <p class="text-sm text-navy">Confirm the asking price to unlock PNG downloads. Copy still works.</p>
      <%= button_to "I confirm this price is correct", confirm_price_listing_path(listing), method: :patch, class: "btn btn-danger" %>
    </div>
  <% end %>

  <section class="mt-10">
    <h2 class="font-serif text-3xl text-navy">Posters</h2>
    <p class="mt-2 text-sm text-navy/60">Banner follows the listing stage. Free plans include a watermark.</p>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      <% GeneratedAsset::TEMPLATE_KEYS.each do |key| %>
        <% asset = pack.generated_assets.find { |item| item.template_key == key } %>
        <figure class="card p-3">
          <% if asset&.image&.attached? %>
            <%= image_tag asset.image, class: "aspect-square w-full rounded-xl object-cover", alt: key.tr("_", " ") %>
          <% else %>
            <div class="flex aspect-square items-center justify-center rounded-xl bg-sand p-4 text-center text-sm text-navy/60">
              PNG not ready — copy still works. HTML preview is below if you redraw.
            </div>
            <div class="mt-2 max-h-40 overflow-hidden rounded-xl">
              <div class="origin-top-left scale-[0.2]">
                <%= render template: "packs/templates/#{key}", layout: false %>
              </div>
            </div>
          <% end %>
          <figcaption class="mt-3 flex items-center justify-between text-sm">
            <span><%= key.tr("_", " ").titleize %></span>
            <span class="flex gap-3">
              <% if asset&.persisted? %>
                <%= button_to "Redraw", regenerate_listing_content_pack_generated_asset_path(listing, pack, asset), method: :post, class: "text-clay" %>
                <% if listing.price_confirmed? && asset.image.attached? %>
                  <%= link_to "PNG", rails_blob_path(asset.image, disposition: "attachment"), class: "underline" %>
                <% end %>
              <% end %>
            </span>
          </figcaption>
        </figure>
      <% end %>
    </div>
  </section>

  <% copy_tabs = [
    ["post", "Post", [
      ["facebook_caption", "Facebook profile"],
      ["facebook_group_caption", "Facebook group"]
    ]],
    ["marketplace", "Marketplace", [
      ["marketplace_caption", "Marketplace blurb"],
      ["listing_description", "Portal description"]
    ]],
    ["social", "IG + ads", [
      ["instagram_caption", "Instagram"],
      ["facebook_ad_copy", "Facebook ad"]
    ]],
    ["messenger", "Messenger", [
      ["messenger_followup", "Follow-up DM"]
    ]],
    ["seller", "Seller", [
      ["seller_report", "Seller report"]
    ]]
  ] %>

  <section class="mt-14" data-controller="tabs" data-tabs-active-value="post">
    <h2 class="font-serif text-3xl text-navy">Captions and follow-ups</h2>
    <div class="mt-4 flex flex-wrap gap-2" role="tablist">
      <% copy_tabs.each do |id, label, _fields| %>
        <button type="button" class="btn btn-secondary" role="tab" data-tabs-target="tab" data-tabs-id-param="<%= id %>" data-action="tabs#select"><%= label %></button>
      <% end %>
    </div>

    <% copy_tabs.each do |id, _label, fields| %>
      <div class="mt-6 space-y-6 <%= "hidden" unless id == "post" %>" data-tabs-target="panel" data-tab="<%= id %>" role="tabpanel">
        <% fields.each do |field, label| %>
          <div data-controller="clipboard" class="card p-5">
            <div class="mb-2 flex flex-wrap items-center justify-between gap-3">
              <h3 class="font-medium text-navy"><%= label %></h3>
              <div class="flex gap-2">
                <button type="button" class="btn btn-secondary py-1 text-sm" data-clipboard-target="button" data-action="clipboard#copy">Copy</button>
                <%= button_to "Rewrite", listing_content_pack_caption_path(listing, pack, field), method: :patch, class: "btn-ghost text-sm text-clay" %>
              </div>
            </div>
            <%= form_with model: pack, url: listing_content_pack_caption_path(listing, pack, field), method: :patch do |form| %>
              <%= form.text_area field, rows: (field == "seller_report" ? 10 : 7), data: { clipboard_target: "source" }, class: "field bg-paper" %>
              <%= form.submit "Save edits", class: "mt-3 cursor-pointer text-sm text-navy underline" %>
            <% end %>
          </div>
        <% end %>
        <% if id == "seller" %>
          <%= link_to "Open printable seller report", seller_report_listing_path(listing), class: "btn btn-secondary" %>
        <% end %>
      </div>
    <% end %>
  </section>
<% else %>
  <%= render "shared/empty_state",
        title: "No pack yet",
        body: "Generate captions, a seller recap, and posters for this listing.",
        action: button_to("Generate pack", listing_content_packs_path(listing), method: :post, class: "btn btn-primary") %>
<% end %>
