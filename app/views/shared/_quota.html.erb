<% used, total = quota_fraction(user) %>
<div>
  <p class="text-sm text-navy/70"><%= quota_copy(user) %></p>
  <% if used %>
    <div class="mt-2 h-1.5 w-40 overflow-hidden rounded-full bg-sand" aria-hidden="true">
      <div class="h-full rounded-full bg-clay" style="width: <%= (used.to_f / total * 100).clamp(0, 100) %>%"></div>
    </div>
  <% end %>
</div>
