<div class="card mx-auto mt-12 max-w-lg p-8 text-center">
  <% if local_assigns[:kicker] %>
    <p class="kicker"><%= kicker %></p>
  <% end %>
  <h2 class="mt-3 font-serif text-3xl text-navy"><%= title %></h2>
  <p class="mt-3 text-navy/70"><%= body %></p>
  <% if local_assigns[:action] %>
    <div class="mt-6"><%= action %></div>
  <% end %>
</div>
