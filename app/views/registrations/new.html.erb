<% content_for :title, "Create account — ListingPack" %>

<div class="mx-auto max-w-md">
  <%= app_brand variant: :auth, class: "mx-auto" %>
  <%= render "shared/onboarding_steps", current: :account %>
  <h1 class="font-serif text-4xl text-navy">Create account</h1>
  <p class="mt-2 text-navy/70">Three free packs a month. No card.</p>

  <%= form_with model: @user, url: registration_path, class: "mt-8 space-y-5" do |form| %>
    <% if @user.errors.any? %>
      <div class="flash flash-alert">
        <ul class="list-disc pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, class: field_classes(@user, :email_address) %>
      <%= field_error @user, :email_address %>
    </div>
    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, maxlength: 72, class: field_classes(@user, :password) %>
      <%= field_error @user, :password %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "label" %>
      <%= form.password_field :password_confirmation, required: true, maxlength: 72, class: field_classes(@user, :password_confirmation) %>
    </div>
    <%= form.submit "Create account", class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-sm text-navy/60">Already have an account? <%= link_to "Log in", new_session_path, class: "text-clay underline" %></p>
</div>
