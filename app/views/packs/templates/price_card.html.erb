<div class="poster" style="width:1080px;height:1080px;display:flex;flex-direction:column;position:relative;background:#f3eee4;font-family:Arial,sans-serif;color:<%= @brand.ink %>;">
  <div style="height:620px;position:relative;background:<%= @brand.ink %>;">
    <% if @photo_uri.present? %>
      <img src="<%= @photo_uri %>" alt="" style="width:100%;height:100%;object-fit:cover;">
    <% end %>
  </div>
  <div style="flex:1;padding:48px 56px 40px;display:flex;flex-direction:column;justify-content:space-between;">
    <div>
      <p style="margin:0 0 8px;letter-spacing:.16em;font-size:18px;color:<%= @brand.accent %>;font-weight:700;"><%= @listing.stage_banner %></p>
      <h1 style="margin:0 0 12px;font-family:Georgia,serif;font-size:48px;line-height:1.15;overflow:hidden;"><%= @listing.title %></h1>
      <p style="margin:0;font-size:22px;opacity:.8;"><%= @listing.location %></p>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;">
      <div>
        <p style="margin:0;font-size:40px;font-weight:700;"><%= @listing.peso_label %></p>
        <p style="margin:8px 0 0;font-size:20px;"><%= @listing.facts_line.presence || "Ask for the full spec sheet" %></p>
        <p style="margin:8px 0 0;font-size:16px;opacity:.8;"><%= @listing.ph_badges.join(" · ") %></p>
      </div>
      <div style="text-align:right;">
        <% if @logo_uri.present? %>
          <img src="<%= @logo_uri %>" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:10px;margin:0 0 10px auto;display:block;">
        <% end %>
        <p style="margin:0;font-weight:700;"><%= @brand.name %></p>
        <p style="margin:6px 0 0;"><%= @brand.phone %></p>
      </div>
    </div>
  </div>
  <% if @watermark %>
    <div style="position:absolute;top:280px;left:50%;transform:translateX(-50%) rotate(-18deg);font-size:52px;color:#fff;opacity:.08;letter-spacing:.18em;white-space:nowrap;pointer-events:none;">LISTINGPACK FREE</div>
  <% end %>
</div>
