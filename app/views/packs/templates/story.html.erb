<%# 1080×1920 — Instagram / Facebook story %>
<div class="poster" style="width:1080px;height:1920px;position:relative;overflow:hidden;font-family:Georgia,serif;color:#fff;background:<%= @brand.ink %>;">
  <% if @photo_uri.present? %>
    <img src="<%= @photo_uri %>" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
  <% end %>
  <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.2) 10%,rgba(20,33,61,.2) 45%,rgba(20,33,61,.92) 100%);"></div>
  <div style="position:absolute;top:72px;left:56px;right:56px;display:flex;justify-content:space-between;align-items:center;">
    <div style="background:<%= @brand.accent %>;color:#fff;padding:16px 24px;letter-spacing:.18em;font-family:Arial,sans-serif;font-size:24px;font-weight:700;"><%= @listing.stage_banner %></div>
    <% if @logo_uri.present? %>
      <img src="<%= @logo_uri %>" alt="" style="width:64px;height:64px;object-fit:cover;border-radius:14px;background:#fff;">
    <% end %>
  </div>
  <div style="position:absolute;left:56px;right:56px;bottom:96px;">
    <p style="margin:0 0 16px;font-size:30px;letter-spacing:.1em;font-family:Arial,sans-serif;opacity:.85;"><%= @listing.location %></p>
    <h1 style="margin:0 0 28px;font-size:78px;line-height:1.05;"><%= @listing.title %></h1>
    <p style="margin:0 0 14px;font-size:48px;font-family:Arial,sans-serif;font-weight:700;"><%= @listing.peso_label %></p>
    <p style="margin:0 0 36px;font-size:28px;font-family:Arial,sans-serif;opacity:.9;"><%= @listing.facts_line %></p>
    <p style="margin:0;font-family:Arial,sans-serif;font-size:26px;"><%= @brand.name %><% if @brand.phone.present? %> · <%= @brand.phone %><% end %></p>
  </div>
  <% if @watermark %>
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(-18deg);font-family:Arial,sans-serif;font-size:56px;opacity:.28;letter-spacing:.2em;">LISTINGPACK FREE</div>
  <% end %>
</div>
