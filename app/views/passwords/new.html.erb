<% content_for :title, "Forgot password — ListingPack" %>

<div class="mx-auto max-w-md">
  <h1 class="font-serif text-4xl text-navy">Forgot your password?</h1>
  <p class="mt-2 text-navy/70">We’ll email a reset link if that address has an account.</p>

  <%= form_with url: passwords_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
    </div>
    <%= form.submit "Email reset instructions", class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-sm text-navy/60"><%= link_to "Back to log in", new_session_path, class: "underline" %></p>
</div>
