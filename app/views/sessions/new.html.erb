<% content_for :title, "Log in — ListingPack" %>

<div class="mx-auto max-w-md">
  <%= app_brand variant: :auth, class: "mx-auto" %>
  <p class="kicker mt-6">Studio</p>
  <h1 class="mt-2 font-serif text-4xl text-navy">Log in</h1>

  <%= form_with url: session_url, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
    </div>
    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field" %>
    </div>
    <%= form.submit "Log in", class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-sm text-navy/60">
    <%= link_to "Forgot password?", new_password_path, class: "underline" %>
    ·
    <%= link_to "Create account", new_registration_path, class: "text-clay underline" %>
  </p>
</div>
